# GitHub App settings for `node dist/server.js`
APP_ID=
# PEM contents (escape newlines as \n) or base64 of the PEM
PRIVATE_KEY=
WEBHOOK_SECRET=
PORT=3000
# Path of the policy file inside protected repositories
POLICY_PATH=.provenance-policy.yml
# Set to false to stop the App from applying `require.labels`
APPLY_LABELS=true
